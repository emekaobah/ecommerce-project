# Copy to .env for local development. Services come from the root docker-compose.yml.
# http://localhost:8081 is the Expo web dev server.
STORE_CORS=http://localhost:8000,http://localhost:8081,https://docs.medusajs.com
ADMIN_CORS=http://localhost:7000,http://localhost:9000
VENDOR_CORS=http://localhost:7001,http://localhost:8081
AUTH_CORS=http://localhost:7000,http://localhost:7001,http://localhost:9000,http://localhost:8081
REDIS_URL=redis://localhost:6381
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://oja:oja@localhost:5434/oja
MERCUR_VENDOR_URL=http://localhost:7001
STOREFRONT_REVALIDATE_URL=http://localhost:3000
STOREFRONT_REVALIDATE_SECRET=supersecret
# Clerk (buyer sign-in). The PEM public key verifies session tokens without a network call:
# Clerk Dashboard → API keys → JWT public key → PEM. The secret key is the fallback.
# Leave both empty to run without buyer sign-in.
CLERK_JWT_KEY=
CLERK_SECRET_KEY=
# Optional comma-separated origins allowed in a token's azp claim (web clients only).
CLERK_AUTHORIZED_PARTIES=
# Catalogue enrichment (#35): product databases asked, in priority order, for fields an
# import left empty. Ids: catalogue, open_food_facts, open_beauty_facts, open_products_facts.
# Unset uses all four; empty asks none. Trusted sources' data needs no review (unset trusts
# only the catalogue). The demo trusts Open Facts; it is crowd-sourced, so in production list
# only curated databases here.
ENRICHMENT_SOURCES=catalogue,open_food_facts,open_beauty_facts,open_products_facts
ENRICHMENT_TRUSTED_SOURCES=catalogue,open_food_facts,open_beauty_facts,open_products_facts
# AI drafts (#36): add ai_draft last in ENRICHMENT_SOURCES (unset includes it when a key is set)
# and Claude drafts the fields the databases left empty from the product's photo and data.
# Drafts are flagged and always sent for review, so ai_draft is never trusted.
ANTHROPIC_API_KEY=
# Paystack (checkout, and resolving shops' bank accounts so they go live, #26). Dashboard → Settings → API Keys & Webhooks → test secret key. Leave empty
# to run without payments; the seed then offers Medusa's no-charge system provider instead.
# Webhooks need a public URL: see "Paystack webhooks" in the README.
PAYSTACK_SECRET_KEY=
# Shipbubble (delivery, #23). Dashboard → Settings → API keys → sandbox key (sb_sandbox_…). Required:
# the API refuses to start without it. Validates delivery addresses and quotes courier rates;
# the shops' pickup addresses are validated when saved, so a shop goes live (#26).
SHIPBUBBLE_API_KEY=

# Google address lookup for buyers' delivery addresses (ADR 0002, #40). A Google Cloud key with
# Places API (New) and Geocoding API enabled, restricted to those two APIs. Required: the API
# refuses to start without it. Set a budget alert on the project.
GOOGLE_MAPS_API_KEY=

# Expo push (#27). Pushes go out without a token; set one (expo.dev → Account settings → Access
# tokens) once the Expo project turns on enhanced push security.
EXPO_ACCESS_TOKEN=
