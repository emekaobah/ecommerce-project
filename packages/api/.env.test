# Integration tests create and drop a temporary database on this server.
# Defaults match the root docker-compose.yml; CI overrides via environment.
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=oja
DB_PASSWORD=oja
# The vendor panel origin that invite emails link to.
MERCUR_VENDOR_URL=http://localhost:7001
# Enrichment asks no real product database in tests; suites register fake sources.
ENRICHMENT_SOURCES=
# Medusa's loadEnv reads .env after .env.test, so without this the tests would share the dev
# server's Redis queues and a running `bun run dev` could consume the tests' events. Empty keeps
# them on the in-memory event bus and workflow engine.
REDIS_URL=
# Same reason: a developer's real Apple push key in .env must not send tests' pushes to Apple.
# Suites that send point these at the fake Apple push server (helpers/apns.ts).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_KEY=
