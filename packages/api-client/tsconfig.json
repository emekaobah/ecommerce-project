{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    // The routes' types reach the backend's module services, which use its decorators.
    "experimentalDecorators": true
  },
  "include": ["src"]
}
