{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/api/medusa-config.ts"
      ],
      "env": [
        "NODE_ENV",
        "MERCUR_BACKEND_URL",
        "VITE_MERCUR_BACKEND_URL",
        "VITE_GOOGLE_MAPS_BROWSER_KEY",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "RESEND_API_URL"
      ],
      "passThroughEnv": [
        "S3_BUCKET"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".medusa/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "env": [
        "DB_HOST",
        "DB_PORT",
        "DB_USERNAME",
        "DB_PASSWORD"
      ]
    }
  }
}
