# Copy to .env. On a physical device use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:9000
# EAS project id (`eas init`), for Expo push tokens. Without it the app gets no push notifications.
EAS_PROJECT_ID=
# Sentry (#19). The DSN of this app's Sentry project; leave empty to report nothing.
EXPO_PUBLIC_SENTRY_DSN=
# Release builds upload source maps to Sentry and fail without these (set them as EAS secrets).
# A local release build can skip the upload with SENTRY_DISABLE_AUTO_UPLOAD=true.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
