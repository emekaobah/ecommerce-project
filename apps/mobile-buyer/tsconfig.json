{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The typed client reaches the backend's module services, which use its decorators.
    "experimentalDecorators": true,
    // `react` maps to React 19's types for every import, React Native libraries' included: the root's are React 18 (ADR 0016).
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "./node_modules/@types/react/*.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Bun's test types stay out of the app: tsconfig.test.json checks the tests with them.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "android",
    "ios",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
