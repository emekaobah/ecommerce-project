# Copy to .env. On a physical device use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:9000
# Publishable key from the admin panel (Settings → Publishable API keys) or the seed output.
EXPO_PUBLIC_PUBLISHABLE_KEY=
# Clerk Dashboard → API keys → Publishable key. Also enable Native applications and the
# Google, Apple and email sign-in methods for the instance (see the README).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
