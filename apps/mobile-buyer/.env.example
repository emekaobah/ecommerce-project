# Copy to .env. On a physical device use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:9000
# Publishable key from the admin panel (Settings → Publishable API keys) or the seed output.
EXPO_PUBLIC_PUBLISHABLE_KEY=
# Clerk Dashboard → API keys → Publishable key. Also enable Native applications and the
# Google, Apple and email sign-in methods for the instance (see the README).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Google Cloud keys for the delivery address pin map, restricted to the Maps SDK for iOS and for
# Android respectively. Baked into the native projects at prebuild (npx expo prebuild).
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
# EAS project id (`eas init`), for Expo push tokens. Without it the app gets no push notifications.
EAS_PROJECT_ID=
# Sentry (#19). The DSN of this app's Sentry project; leave empty to report nothing.
EXPO_PUBLIC_SENTRY_DSN=
# Release builds upload source maps to Sentry and fail without these (set them as EAS secrets).
# A local release build can skip the upload with SENTRY_DISABLE_AUTO_UPLOAD=true.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
